#!/usr/bin/env bash
# pre-commit hook — enforces code formatting, lint, and go.mod consistency.
# Installed by scripts/install-hooks.sh.
set -euo pipefail

echo "Running pre-commit checks..."

# ── 1. Go formatting ──────────────────────────────────────────────────────
echo "Checking formatting..."
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
  echo "ERROR: The following files are not formatted:"
  echo "$UNFORMATTED"
  echo ""
  echo "Run: go fmt ./..."
  exit 1
fi

# ── 2. golangci-lint ──────────────────────────────────────────────────────
echo "Running linter..."
if ! golangci-lint run --new-from-rev=HEAD~1 ./...; then
  echo "ERROR: Linting failed. Fix the issues above."
  exit 1
fi

# ── 3. go.mod consistency ─────────────────────────────────────────────────
echo "Checking go.mod..."
go mod tidy
if ! git diff --exit-code go.mod go.sum; then
  echo "ERROR: go.mod or go.sum is not up to date"
  echo ""
  echo "Run: go mod tidy"
  exit 1
fi

echo "✓ All pre-commit checks passed"
